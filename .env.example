# Jangan commit .env. Semua aktivitas = SIMULASI (read-only market intelligence, practice positions). Tidak ada dana nyata.
RYO_MCP_URL=https://app-ryochan.com/api/mcp   # nama env resmi dari RYO Builder MCP Guide
RYO_MCP_KEY=                  # builder credential (ryo_mcp_...); JANGAN pernah dicetak/dilog/commit
LLM_API_KEY=                  # untuk narasi kartu (provider/model dipin di docs/versions.md, TASKS 2.3); boleh kosong → narration_unavailable
DB_PATH=./data/ryo.db         # SQLite: snapshots, swaps, ledger, grades
RECORDER_INTERVAL_S=3600      # jarak antar siklus; deep_analysis mahal — sesuaikan dengan kuota
RECORDER_MAX_SYMBOLS=25       # simbol per siklus; kalibrasi terhadap kuota dari GET /whoami (TASKS 0.3)
RECORDER_MAX_FOLLOWUPS=20     # anggaran pembacaan kedua per siklus (outcome T+24j); simbol pensiun setelah rentang 24j
RECORDER_MAX_FAILED_CYCLES=3  # siklus beruntun tanpa snapshot sebelum perekam berhenti dengan kode != 0
PRACTICE_SIZE_USD=100         # ukuran practice trade tetap (item 11 Bunryō opsional dapat menimpa)
WATCHLIST=SOL,BTC,ETH,BNB     # simbol yang di-preflight tiap tick
UI_PORT=8000
TZ_DISPLAY=Asia/Tokyo         # semua jam di UI = JST
